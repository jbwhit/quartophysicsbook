#!/bin/sh
# Auto-format and lint staged Python files with ruff (from the project's dev
# deps via uv). Enable with `make setup` (sets core.hooksPath to .githooks).

staged_py=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
[ -z "$staged_py" ] && exit 0

uv run ruff format $staged_py
uv run ruff check --fix $staged_py
git add $staged_py

# Block the commit if anything remains that couldn't be auto-fixed.
uv run ruff check $staged_py
